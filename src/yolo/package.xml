<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>yolo</name>
  <version>2.0.0</version>
  <description>ZED 2 hand sign detection and person tracking for mobile robot. Supports both real ZED2 camera and Gazebo simulation.</description>
  <maintainer email="thuong.trandinh@hcmutcmut.edu.vn">Thuong Tran Dinh</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake_python</buildtool_depend>
  <build_depend>rclpy</build_depend>
  <exec_depend>rclpy</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>interfaces</exec_depend>
  <exec_depend>cv_bridge</exec_depend>
  <exec_depend>tf2_ros</exec_depend>
  <exec_depend>tf2_geometry_msgs</exec_depend>
  <exec_depend>message_filters</exec_depend>

  <!-- Real camera dependencies (optional) -->
  <exec_depend>pyzed</exec_depend>
  <exec_depend>zed_msgs</exec_depend>
  
  <!-- Python dependencies -->
  <exec_depend>opencv-python</exec_depend>
  <exec_depend>ultralytics</exec_depend>
  <exec_depend>numpy</exec_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
