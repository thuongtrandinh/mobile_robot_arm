<?xml version="1.0" ?>
<sdf version="1.7">
    <world name="amr_simulation">
        <physics type="ode">
            <max_step_size>0.01</max_step_size>
            <real_time_factor>1.0</real_time_factor>
        </physics>
        
        <light type="directional" name="sun">
            <cast_shadows>true</cast_shadows>
            <pose>0 0 10 0 0 0</pose>
            <diffuse>0.8 0.8 0.8 1</diffuse>
            <specular>0.2 0.2 0.2 1</specular>
            <attenuation>
                <range>1000</range>
                <constant>0.9</constant>
                <linear>0.01</linear>
                <quadratic>0.001</quadratic>
            </attenuation>
            <direction>-0.5 0.1 -0.9</direction>
        </light>
        
        <!-- Ground plane -->
        <model name="ground_plane">
            <static>true</static>
            <link name="link">
                <collision name="collision">
                    <geometry>
                        <plane>
                            <normal>0 0 1</normal>
                        </plane>
                    </geometry>
                </collision>
                <visual name="visual">
                    <geometry>
                        <plane>
                            <normal>0 0 1</normal>
                            <size>100 100</size>
                        </plane>
                    </geometry>
                    <material>
                        <ambient>0.8 0.8 0.8 1</ambient>
                        <diffuse>0.8 0.8 0.8 1</diffuse>
                        <specular>0.8 0.8 0.8 1</specular>
                    </material>
                </visual>
            </link>
        </model>

        <!-- ============== STATIC OBSTACLES ============== -->
        
        <!-- Obstacle 1: Red Box (top-left) -->
        <model name="obstacle_box_1">
            <pose>-2.0 -2.0 0.25 0 0 0</pose>
            <static>true</static>
            <link name="link">
                <collision name="collision">
                    <geometry>
                        <box>
                            <size>0.5 0.5 0.5</size>
                        </box>
                    </geometry>
                </collision>
                <visual name="visual">
                    <geometry>
                        <box>
                            <size>0.5 0.5 0.5</size>
                        </box>
                    </geometry>
                    <material>
                        <ambient>1 0 0 1</ambient>
                        <diffuse>1 0 0 1</diffuse>
                    </material>
                </visual>
            </link>
        </model>

        <!-- Obstacle 2: Green Box (top-right) -->
        <model name="obstacle_box_2">
            <pose>2.5 -2.0 0.25 0 0 0</pose>
            <static>true</static>
            <link name="link">
                <collision name="collision">
                    <geometry>
                        <box>
                            <size>0.5 0.5 0.5</size>
                        </box>
                    </geometry>
                </collision>
                <visual name="visual">
                    <geometry>
                        <box>
                            <size>0.5 0.5 0.5</size>
                        </box>
                    </geometry>
                    <material>
                        <ambient>0 1 0 1</ambient>
                        <diffuse>0 1 0 1</diffuse>
                    </material>
                </visual>
            </link>
        </model>

        <!-- Obstacle 3: Blue Box (bottom-left) -->
        <model name="obstacle_box_3">
            <pose>-2.0 2.0 0.25 0 0 0</pose>
            <static>true</static>
            <link name="link">
                <collision name="collision">
                    <geometry>
                        <box>
                            <size>0.5 0.5 0.5</size>
                        </box>
                    </geometry>
                </collision>
                <visual name="visual">
                    <geometry>
                        <box>
                            <size>0.5 0.5 0.5</size>
                        </box>
                    </geometry>
                    <material>
                        <ambient>0 0 1 1</ambient>
                        <diffuse>0 0 1 1</diffuse>
                    </material>
                </visual>
            </link>
        </model>

        <!-- Obstacle 4: Orange Box (center) -->
        <model name="obstacle_box_4">
            <pose>0.0 0.0 0.25 0 0 0</pose>
            <static>true</static>
            <link name="link">
                <collision name="collision">
                    <geometry>
                        <box>
                            <size>0.4 0.4 0.5</size>
                        </box>
                    </geometry>
                </collision>
                <visual name="visual">
                    <geometry>
                        <box>
                            <size>0.4 0.4 0.5</size>
                        </box>
                    </geometry>
                    <material>
                        <ambient>1 0.5 0 1</ambient>
                        <diffuse>1 0.5 0 1</diffuse>
                    </material>
                </visual>
            </link>
        </model>

        <!-- Obstacle 5: Wall (horizontal line) -->
        <model name="obstacle_wall">
            <pose>0.5 -3.0 0.25 0 0 0</pose>
            <static>true</static>
            <link name="link">
                <collision name="collision">
                    <geometry>
                        <box>
                            <size>4.0 0.3 0.5</size>
                        </box>
                    </geometry>
                </collision>
                <visual name="visual">
                    <geometry>
                        <box>
                            <size>4.0 0.3 0.5</size>
                        </box>
                    </geometry>
                    <material>
                        <ambient>0.5 0.5 0.5 1</ambient>
                        <diffuse>0.5 0.5 0.5 1</diffuse>
                    </material>
                </visual>
            </link>
        </model>

        <!-- ============== DYNAMIC ACTORS (Moving Humans) ============== -->
        
        <!-- Actor 1: Human walking in path (vertical line) -->
        <actor name="actor_human_1">
            <pose>1.5 1.0 0.0 0 0 0</pose>
            <skin>
                <filename>file://media/models/human.dae</filename>
                <scale>1.0</scale>
            </skin>
            <animation name="walking">
                <filename>file://media/models/avatar_run.dae</filename>
                <interpolate_x>true</interpolate_x>
            </animation>
            <script>
                <loop>true</loop>
                <auto_start>true</auto_start>
                <trajectory id="0" type="walking">
                    <waypoint>
                        <time>0</time>
                        <pose>1.5 1.0 0 0 0 0</pose>
                    </waypoint>
                    <waypoint>
                        <time>6</time>
                        <pose>1.5 -1.0 0 0 0 0</pose>
                    </waypoint>
                    <waypoint>
                        <time>12</time>
                        <pose>1.5 1.0 0 0 0 0</pose>
                    </waypoint>
                </trajectory>
            </script>
        </actor>

        <!-- Actor 2: Human walking in diagonal path -->
        <actor name="actor_human_2">
            <pose>-1.5 -1.5 0.0 0 0 0</pose>
            <skin>
                <filename>file://media/models/human.dae</filename>
                <scale>0.95</scale>
            </skin>
            <animation name="walking">
                <filename>file://media/models/avatar_run.dae</filename>
                <interpolate_x>true</interpolate_x>
            </animation>
            <script>
                <loop>true</loop>
                <auto_start>true</auto_start>
                <trajectory id="0" type="walking">
                    <waypoint>
                        <time>0</time>
                        <pose>-1.5 -1.5 0 0 0 -0.785</pose>
                    </waypoint>
                    <waypoint>
                        <time>8</time>
                        <pose>1.5 1.5 0 0 0 1.57</pose>
                    </waypoint>
                    <waypoint>
                        <time>16</time>
                        <pose>-1.5 -1.5 0 0 0 -0.785</pose>
                    </waypoint>
                </trajectory>
            </script>
        </actor>

        <!-- Actor 3: Human walking around square path -->
        <actor name="actor_human_3">
            <pose>2.5 1.5 0.0 0 0 0</pose>
            <skin>
                <filename>file://media/models/human.dae</filename>
                <scale>1.05</scale>
            </skin>
            <animation name="walking">
                <filename>file://media/models/avatar_run.dae</filename>
                <interpolate_x>true</interpolate_x>
            </animation>
            <script>
                <loop>true</loop>
                <auto_start>true</auto_start>
                <trajectory id="0" type="walking">
                    <waypoint>
                        <time>0</time>
                        <pose>2.5 1.5 0 0 0 0</pose>
                    </waypoint>
                    <waypoint>
                        <time>5</time>
                        <pose>2.5 -1.5 0 0 0 -1.57</pose>
                    </waypoint>
                    <waypoint>
                        <time>10</time>
                        <pose>-2.5 -1.5 0 0 0 3.14</pose>
                    </waypoint>
                    <waypoint>
                        <time>15</time>
                        <pose>-2.5 1.5 0 0 0 1.57</pose>
                    </waypoint>
                    <waypoint>
                        <time>20</time>
                        <pose>2.5 1.5 0 0 0 0</pose>
                    </waypoint>
                </trajectory>
            </script>
        </actor>

    </world>
</sdf>
