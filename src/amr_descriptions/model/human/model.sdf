<?xml version="1.0" ?>
<sdf version="1.9">
  <model name="human">
    <!-- Base link representing the pelvis -->
    <link name="pelvis">
      <inertial>
        <mass>10</mass>
        <inertia>
          <ixx>0.5</ixx>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyy>0.5</iyy>
          <iyz>0</iyz>
          <izz>0.5</izz>
        </inertia>
      </inertial>
      <visual name="pelvis_visual">
        <geometry>
          <box>
            <size>0.25 0.15 0.25</size>
          </box>
        </geometry>
        <material>
          <ambient>0.9 0.7 0.5 1</ambient>
          <diffuse>0.9 0.7 0.5 1</diffuse>
        </material>
      </visual>
      <collision name="pelvis_collision">
        <geometry>
          <box>
            <size>0.25 0.15 0.25</size>
          </box>
        </geometry>
      </collision>
    </link>

    <!-- Torso -->
    <link name="torso">
      <pose relative_to="pelvis">0 0 0.25 0 0 0</pose>
      <inertial>
        <mass>8</mass>
        <inertia>
          <ixx>0.3</ixx>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyy>0.3</iyy>
          <iyz>0</iyz>
          <izz>0.2</izz>
        </inertia>
      </inertial>
      <visual name="torso_visual">
        <geometry>
          <box>
            <size>0.25 0.15 0.35</size>
          </box>
        </geometry>
        <material>
          <ambient>0.9 0.7 0.5 1</ambient>
          <diffuse>0.9 0.7 0.5 1</diffuse>
        </material>
      </visual>
      <collision name="torso_collision">
        <geometry>
          <box>
            <size>0.25 0.15 0.35</size>
          </box>
        </geometry>
      </collision>
    </link>

    <joint name="pelvis_torso" type="fixed">
      <parent>pelvis</parent>
      <child>torso</child>
    </joint>

    <!-- Head -->
    <link name="head">
      <pose relative_to="torso">0 0 0.25 0 0 0</pose>
      <inertial>
        <mass>2</mass>
        <inertia>
          <ixx>0.05</ixx>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyy>0.05</iyy>
          <iyz>0</iyz>
          <izz>0.05</izz>
        </inertia>
      </inertial>
      <visual name="head_visual">
        <geometry>
          <sphere>
            <radius>0.1</radius>
          </sphere>
        </geometry>
        <material>
          <ambient>0.9 0.7 0.5 1</ambient>
          <diffuse>0.9 0.7 0.5 1</diffuse>
        </material>
      </visual>
      <collision name="head_collision">
        <geometry>
          <sphere>
            <radius>0.1</radius>
          </sphere>
        </geometry>
      </collision>
    </link>

    <joint name="torso_head" type="revolute">
      <parent>torso</parent>
      <child>head</child>
      <axis>
        <xyz>0 1 0</xyz>
        <limit>
          <lower>-0.5</lower>
          <upper>0.5</upper>
        </limit>
      </axis>
    </joint>

    <!-- Left Arm -->
    <link name="left_upper_arm">
      <pose relative_to="torso">0.15 0.1 0.1 0 0 0</pose>
      <inertial>
        <mass>2</mass>
        <inertia>
          <ixx>0.02</ixx>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyy>0.02</iyy>
          <iyz>0</iyz>
          <izz>0.01</izz>
        </inertia>
      </inertial>
      <visual name="left_upper_arm_visual">
        <geometry>
          <box>
            <size>0.08 0.08 0.3</size>
          </box>
        </geometry>
        <material>
          <ambient>0.9 0.7 0.5 1</ambient>
          <diffuse>0.9 0.7 0.5 1</diffuse>
        </material>
      </visual>
      <collision name="left_upper_arm_collision">
        <geometry>
          <box>
            <size>0.08 0.08 0.3</size>
          </box>
        </geometry>
      </collision>
    </link>

    <joint name="left_shoulder" type="revolute">
      <parent>torso</parent>
      <child>left_upper_arm</child>
      <axis>
        <xyz>1 0 0</xyz>
        <limit>
          <lower>-2</lower>
          <upper>2</upper>
        </limit>
      </axis>
    </joint>

    <!-- Right Arm -->
    <link name="right_upper_arm">
      <pose relative_to="torso">-0.15 0.1 0.1 0 0 0</pose>
      <inertial>
        <mass>2</mass>
        <inertia>
          <ixx>0.02</ixx>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyy>0.02</iyy>
          <iyz>0</iyz>
          <izz>0.01</izz>
        </inertia>
      </inertial>
      <visual name="right_upper_arm_visual">
        <geometry>
          <box>
            <size>0.08 0.08 0.3</size>
          </box>
        </geometry>
        <material>
          <ambient>0.9 0.7 0.5 1</ambient>
          <diffuse>0.9 0.7 0.5 1</diffuse>
        </material>
      </visual>
      <collision name="right_upper_arm_collision">
        <geometry>
          <box>
            <size>0.08 0.08 0.3</size>
          </box>
        </geometry>
      </collision>
    </link>

    <joint name="right_shoulder" type="revolute">
      <parent>torso</parent>
      <child>right_upper_arm</child>
      <axis>
        <xyz>1 0 0</xyz>
        <limit>
          <lower>-2</lower>
          <upper>2</upper>
        </limit>
      </axis>
    </joint>

    <!-- Left Leg -->
    <link name="left_upper_leg">
      <pose relative_to="pelvis">0.08 0 -0.15 0 0 0</pose>
      <inertial>
        <mass>4</mass>
        <inertia>
          <ixx>0.08</ixx>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyy>0.08</iyy>
          <iyz>0</iyz>
          <izz>0.03</izz>
        </inertia>
      </inertial>
      <visual name="left_upper_leg_visual">
        <geometry>
          <box>
            <size>0.1 0.1 0.4</size>
          </box>
        </geometry>
        <material>
          <ambient>0.9 0.7 0.5 1</ambient>
          <diffuse>0.9 0.7 0.5 1</diffuse>
        </material>
      </visual>
      <collision name="left_upper_leg_collision">
        <geometry>
          <box>
            <size>0.1 0.1 0.4</size>
          </box>
        </geometry>
      </collision>
    </link>

    <joint name="left_hip" type="revolute">
      <parent>pelvis</parent>
      <child>left_upper_leg</child>
      <axis>
        <xyz>1 0 0</xyz>
        <limit>
          <lower>-1.5</lower>
          <upper>1.5</upper>
        </limit>
      </axis>
    </joint>

    <link name="left_lower_leg">
      <pose relative_to="left_upper_leg">0 0 -0.3 0 0 0</pose>
      <inertial>
        <mass>3</mass>
        <inertia>
          <ixx>0.05</ixx>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyy>0.05</iyy>
          <iyz>0</iyz>
          <izz>0.02</izz>
        </inertia>
      </inertial>
      <visual name="left_lower_leg_visual">
        <geometry>
          <box>
            <size>0.09 0.09 0.4</size>
          </box>
        </geometry>
        <material>
          <ambient>0.9 0.7 0.5 1</ambient>
          <diffuse>0.9 0.7 0.5 1</diffuse>
        </material>
      </visual>
      <collision name="left_lower_leg_collision">
        <geometry>
          <box>
            <size>0.09 0.09 0.4</size>
          </box>
        </geometry>
      </collision>
    </link>

    <joint name="left_knee" type="revolute">
      <parent>left_upper_leg</parent>
      <child>left_lower_leg</child>
      <axis>
        <xyz>1 0 0</xyz>
        <limit>
          <lower>0</lower>
          <upper>2</upper>
        </limit>
      </axis>
    </joint>

    <!-- Right Leg -->
    <link name="right_upper_leg">
      <pose relative_to="pelvis">-0.08 0 -0.15 0 0 0</pose>
      <inertial>
        <mass>4</mass>
        <inertia>
          <ixx>0.08</ixx>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyy>0.08</iyy>
          <iyz>0</iyz>
          <izz>0.03</izz>
        </inertia>
      </inertial>
      <visual name="right_upper_leg_visual">
        <geometry>
          <box>
            <size>0.1 0.1 0.4</size>
          </box>
        </geometry>
        <material>
          <ambient>0.9 0.7 0.5 1</ambient>
          <diffuse>0.9 0.7 0.5 1</diffuse>
        </material>
      </visual>
      <collision name="right_upper_leg_collision">
        <geometry>
          <box>
            <size>0.1 0.1 0.4</size>
          </box>
        </geometry>
      </collision>
    </link>

    <joint name="right_hip" type="revolute">
      <parent>pelvis</parent>
      <child>right_upper_leg</child>
      <axis>
        <xyz>1 0 0</xyz>
        <limit>
          <lower>-1.5</lower>
          <upper>1.5</upper>
        </limit>
      </axis>
    </joint>

    <link name="right_lower_leg">
      <pose relative_to="right_upper_leg">0 0 -0.3 0 0 0</pose>
      <inertial>
        <mass>3</mass>
        <inertia>
          <ixx>0.05</ixx>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyy>0.05</iyy>
          <iyz>0</iyz>
          <izz>0.02</izz>
        </inertia>
      </inertial>
      <visual name="right_lower_leg_visual">
        <geometry>
          <box>
            <size>0.09 0.09 0.4</size>
          </box>
        </geometry>
        <material>
          <ambient>0.9 0.7 0.5 1</ambient>
          <diffuse>0.9 0.7 0.5 1</diffuse>
        </material>
      </visual>
      <collision name="right_lower_leg_collision">
        <geometry>
          <box>
            <size>0.09 0.09 0.4</size>
          </box>
        </geometry>
      </collision>
    </link>

    <joint name="right_knee" type="revolute">
      <parent>right_upper_leg</parent>
      <child>right_lower_leg</child>
      <axis>
        <xyz>1 0 0</xyz>
        <limit>
          <lower>0</lower>
          <upper>2</upper>
        </limit>
      </axis>
    </joint>

    <!-- Plugin to control walking animation -->
    <plugin
      filename="libIgnitionROS2CMakePlugin.so"
      name="human_animation">
    </plugin>
  </model>
</sdf>
