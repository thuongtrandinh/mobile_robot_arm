<?xml version="1.0" encoding="utf-8"?>
<COLLADA xmlns="http://www.collada.org/2005/11/COLLADASchema" version="1.4.1">
  <asset>
    <contributor>
      <authoring_tool>descriptions</authoring_tool>
    </contributor>
    <unit name="meter" meter="1"/>
    <up_axis>Z_UP</up_axis>
  </asset>
  <library_effects>
    <effect id="actor_effect">
      <profile_COMMON>
        <technique sid="common">
          <phong>
            <diffuse><color>0.2 0.7 1.0 1</color></diffuse>
            <ambient><color>0.1 0.1 0.1 1</color></ambient>
          </phong>
        </technique>
      </profile_COMMON>
    </effect>
  </library_effects>
  <library_materials>
    <material id="actor_material" name="actor_material">
      <instance_effect url="#actor_effect"/>
    </material>
  </library_materials>
  <library_geometries>
    <geometry id="box_geom" name="box_geom">
      <mesh>
        <source id="box_positions">
          <float_array id="box_positions_array" count="24">
            -0.25 -0.25 0
             0.25 -0.25 0
             0.25  0.25 0
            -0.25  0.25 0
            -0.25 -0.25 1
             0.25 -0.25 1
             0.25  0.25 1
            -0.25  0.25 1
          </float_array>
          <technique_common>
            <accessor source="#box_positions_array" count="8" stride="3">
              <param name="X" type="float"/>
              <param name="Y" type="float"/>
              <param name="Z" type="float"/>
            </accessor>
          </technique_common>
        </source>
        <vertices id="box_vertices">
          <input semantic="POSITION" source="#box_positions"/>
        </vertices>
        <triangles count="12" material="actor_material">
          <input semantic="VERTEX" source="#box_vertices" offset="0"/>
          <p>
            0 1 2  0 2 3
            4 6 5  4 7 6
            0 4 5  0 5 1
            1 5 6  1 6 2
            2 6 7  2 7 3
            3 7 4  3 4 0
          </p>
        </triangles>
      </mesh>
    </geometry>
  </library_geometries>
  <library_visual_scenes>
    <visual_scene id="Scene" name="Scene">
      <node id="actor_box" name="actor_box" type="NODE">
        <instance_geometry url="#box_geom">
          <bind_material>
            <technique_common>
              <instance_material symbol="actor_material" target="#actor_material"/>
            </technique_common>
          </bind_material>
        </instance_geometry>
      </node>
    </visual_scene>
  </library_visual_scenes>
  <scene>
    <instance_visual_scene url="#Scene"/>
  </scene>
</COLLADA>
