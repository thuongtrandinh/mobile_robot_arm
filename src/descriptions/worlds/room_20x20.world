<?xml version="1.0" ?>
<sdf version="1.6">
  <world name="room_20x20">
    <physics type="ode">
      <max_step_size>0.01</max_step_size>
    </physics>

    <!-- Ground plane - inline definition -->
    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>100 100</size>
            </plane>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>100 100</size>
            </plane>
          </geometry>
          <material>
            <ambient>0.8 0.8 0.8 1</ambient>
            <diffuse>0.8 0.8 0.8 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- Four enclosing walls forming a 20m x 20m square centered at (0,0) -->
    <!-- Wall thickness 0.2m, height 2.5m -->

    <!-- North wall (+Y) -->
    <model name="wall_north">
      <static>true</static>
      <link name="link">
        <pose>0 10.1 1.25 0 0 0</pose>
        <collision name="collision">
          <geometry>
            <box>
              <size>20.4 0.2 2.5</size>
            </box>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <box>
              <size>20.4 0.2 2.5</size>
            </box>
          </geometry>
          <material>
            <ambient>0.7 0.7 0.7 1</ambient>
            <diffuse>0.8 0.8 0.8 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- South wall (-Y) -->
    <model name="wall_south">
      <static>true</static>
      <link name="link">
        <pose>0 -10.1 1.25 0 0 0</pose>
