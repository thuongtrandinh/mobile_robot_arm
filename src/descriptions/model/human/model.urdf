<?xml version="1.0" ?>
<robot name="human_visual">

  <link name="base_link">
    
    <inertial>
      <mass value="65.0"/>
      <origin xyz="0 0 0.9" rpy="0 0 0"/>
      <inertia ixx="1.0" ixy="0" ixz="0" iyy="1.0" iyz="0" izz="1.0"/>
    </inertial>

    <collision>
      <origin xyz="0 0 0.9" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.3" length="1.8"/>
      </geometry>
    </collision>

    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://gazebo_ros/share/gazebo/models/walk_person/meshes/walk.dae" scale="1 1 1"/>
      </geometry>
    </visual>

  </link>

</robot>