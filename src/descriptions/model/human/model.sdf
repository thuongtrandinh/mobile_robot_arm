<?xml version="1.0" ?>
<sdf version="1.6">
  <actor name="human_actor">
    
    <skin>
      <filename>walk.dae</filename>
      <scale>1.0</scale>
    </skin>
    
    <animation name="walking">
      <filename>walk.dae</filename>
      <scale>1.0</scale>
      <interpolate_x>true</interpolate_x>
    </animation>
    
    <script>
      <loop>true</loop>
      <delay_start>0.0</delay_start>
      <auto_start>true</auto_start>
      
      <trajectory id="0" type="walking">
        <waypoint>
          <time>0.0</time>
          <pose>0 0 0 0 0 0</pose>
        </waypoint>
        <waypoint>
          <time>3.0</time>
          <pose>3 0 0 0 0 0</pose> </waypoint>
        <waypoint>
          <time>3.5</time>
          <pose>3 0 0 0 0 3.14159</pose> </waypoint>
        <waypoint>
          <time>6.5</time>
          <pose>0 0 0 0 0 3.14159</pose> </waypoint>
        <waypoint>
          <time>7.0</time>
          <pose>0 0 0 0 0 0</pose> </waypoint>
      </trajectory>
    </script>
    
  </actor>
</sdf>